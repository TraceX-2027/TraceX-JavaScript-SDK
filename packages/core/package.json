{
  "name": "@tracex/core",
  "version": "0.1.0",
  "description": "TraceX shared core client engine and telemetry pipeline",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TraceX-2027/TraceX-JavaScript-SDK.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/TraceX-2027/TraceX-JavaScript-SDK#readme",
  "bugs": {
    "url": "https://github.com/TraceX-2027/TraceX-JavaScript-SDK/issues"
  },
  "author": "TraceX Platform Team <team@tracex.dev>",
  "license": "MIT",
  "keywords": [
    "tracex",
    "telemetry",
    "tracing",
    "monitoring",
    "sdk",
    "error-tracking",
    "apm",
    "ring-buffer",
    "pii-redaction"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
