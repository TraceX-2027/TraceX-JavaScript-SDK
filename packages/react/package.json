{
  "name": "@tracex/react",
  "version": "0.1.0",
  "description": "TraceX SDK for React and browser applications",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TraceX-2027/TraceX-JavaScript-SDK.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/TraceX-2027/TraceX-JavaScript-SDK#readme",
  "bugs": {
    "url": "https://github.com/TraceX-2027/TraceX-JavaScript-SDK/issues"
  },
  "author": "TraceX Platform Team <team@tracex.dev>",
  "license": "MIT",
  "keywords": [
    "tracex",
    "react",
    "browser",
    "frontend",
    "telemetry",
    "tracing",
    "monitoring",
    "sdk",
    "error-tracking",
    "error-boundary"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tracex/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
