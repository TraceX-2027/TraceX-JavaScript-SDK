{
  "name": "@tracex/nextjs",
  "version": "0.1.0",
  "description": "TraceX SDK for Next.js full-stack applications",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TraceX-2027/TraceX-JavaScript-SDK.git",
    "directory": "packages/nextjs"
  },
  "homepage": "https://github.com/TraceX-2027/TraceX-JavaScript-SDK#readme",
  "bugs": {
    "url": "https://github.com/TraceX-2027/TraceX-JavaScript-SDK/issues"
  },
  "author": "TraceX Platform Team <team@tracex.dev>",
  "license": "MIT",
  "keywords": [
    "tracex",
    "nextjs",
    "react",
    "app-router",
    "server-actions",
    "route-handlers",
    "telemetry",
    "tracing",
    "monitoring",
    "sdk",
    "error-tracking"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tracex/core": "workspace:*",
    "@tracex/node": "workspace:*",
    "@tracex/react": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
